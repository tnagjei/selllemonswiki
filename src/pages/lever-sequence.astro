---
// input: Reported Sewer Key and UFO Key lever routes, YouTube lever references, and player checklist state in localStorage
// output: Sell Lemons lever sequence page with route tabs, evidence labels, reset warnings, video embeds, and FAQ
// pos: /Users/tangjei/Documents/建站/游戏站/selllemonswiki/src/pages/lever-sequence.astro (更新规则：文件变更需同步本注释与所属目录 README)
import SiteLayout from "../layouts/SiteLayout.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import VideoGuideBlock from "../components/VideoGuideBlock.astro";

const routeChecklists = [
  {
    id: "sewer-key",
    label: "Sewer Key Route",
    title: "Sewer Key Checklist",
    status: "reported",
    note: "Reported route for the Sewer Key and Cosmic Cash Vine gate. Blue and Teal can refer to the same first lever in different community writeups.",
    steps: [
      "Pull the Blue or Teal lever first.",
      "Pull the Red lever.",
      "Pull the Green lever.",
      "Return to Red and turn it off.",
      "Return to Blue or Teal and turn it off.",
      "Pull the Purple lever.",
      "Pull the Red lever again, then collect the Sewer Key."
    ]
  },
  {
    id: "ufo-key",
    label: "UFO Key Route",
    title: "UFO Key Checklist",
    status: "reported",
    note: "Reported route for the UFO Key and Good Samaritan badge. Treat the repeated Red and Green steps as a route state checklist, not official proof.",
    steps: [
      "Start from a fresh sewer route state.",
      "Pull the Blue or Teal lever.",
      "Pull the Red lever.",
      "Pull the Green lever.",
      "Return to Red and toggle it for the UFO path.",
      "Pull the Purple lever.",
      "Return to Red and toggle it again.",
      "Return to Green and toggle it for the UFO path.",
      "Return to Red and toggle it for the final UFO Key path.",
      "Collect the UFO Key if your investor progress has unlocked it.",
      "Use the Red and Green route steps again if the alien path stays closed.",
      "Talk to the Alien and mark Good Samaritan as reported complete."
    ]
  }
];

const recoveryNotes = [
  {
    title: "Wrong state",
    status: "reported",
    note: "If a door or path does not match the current checklist step, stop pulling extra levers and restart from a fresh server or a known main split."
  },
  {
    title: "Missing key",
    status: "pending",
    note: "If the UFO Key does not appear, community sources point to investor story progress as a possible gate, but this still needs current in-game confirmation."
  },
  {
    title: "Route conflict",
    status: "disputed",
    note: "A simple five-color order appears in some older or broader pages, while the current SERP evidence points to longer route-specific checklists."
  }
];

const routeSummaryRows = [
  {
    route: "Sewer Key",
    status: "reported/disputed",
    summary: "Blue/Teal, Red, Green, Red off, Blue/Teal off, Purple, Red."
  },
  {
    route: "UFO Key compact route",
    status: "reported/disputed",
    summary: "Blue/Teal, Red, Green, Red, Purple, Red, Green, Red."
  },
  {
    route: "Longer community variant",
    status: "disputed",
    summary: "Some sources add extra route-state actions, so this page keeps conflict notes visible instead of merging every version."
  }
];

const youtubeEmbeds = [
  {
    title: "ALL LEVERS LOCATIONS",
    embedUrl: "https://www.youtube-nocookie.com/embed/8MlwMpB9bdk",
    sourceUrl: "https://www.youtube.com/watch?v=8MlwMpB9bdk",
    status: "youtube_embed",
    note: "Visual lever-location reference only. It does not verify the live route state."
  },
  {
    title: "Full Sewer Key Maze Guide",
    embedUrl: "https://www.youtube-nocookie.com/embed/L_2dj-irnjY",
    sourceUrl: "https://www.youtube.com/watch?v=L_2dj-irnjY",
    status: "youtube_embed",
    note: "Useful for sewer-route orientation, not official route proof."
  },
  {
    title: "Sell Lemons Maze Guide UFO KEY & SEWER KEY",
    embedUrl: "https://www.youtube-nocookie.com/embed/05cLLRLUZR8",
    sourceUrl: "https://www.youtube.com/watch?v=05cLLRLUZR8",
    status: "youtube_embed",
    note: "Cluster video for both key routes. Reward and route details remain reported or disputed."
  }
];

const faqItems = [
  {
    question: "Is this lever sequence verified?",
    answer: "No. The route is reported or disputed until the site checks the current live maze in-game."
  },
  {
    question: "Are Blue and Teal the same lever?",
    answer: "That naming is disputed across community sources, so the checklist writes Blue/Teal instead of pretending the conflict is settled."
  },
  {
    question: "Can I switch from Sewer Key to UFO Key halfway through?",
    answer: "No. Treat each route as a separate state. Mixing routes is the main reason doors or keys fail to appear."
  },
  {
    question: "What should I do after a wrong lever?",
    answer: "Stop entering more steps, return to a known checkpoint, or restart from a fresh server before following the checklist again."
  },
  {
    question: "Do the embedded videos prove the route?",
    answer: "No. Videos help visual orientation, but route and reward claims still need evidence labels."
  }
];
---

<SiteLayout title="Sell Lemons Lever Sequence: Sewer and UFO Key Checklist" description="Use a Sell Lemons lever sequence checklist for Sewer Key, UFO Key, wrong state recovery, conflict notes, and evidence-labeled mobile tracking.">
  <main>
    <section class="page-hero guide-detail-hero">
      <div class="wrap page-hero__grid">
        <div>
          <p class="eyebrow">Checklist Tool</p>
          <h1>Sell Lemons Lever Sequence</h1>
          <p>Switch between the Sewer Key and UFO Key routes before touching any lever. Each checklist saves locally in your browser, but every route claim remains reported until confirmed in-game.</p>
        </div>
        <img src="/sell_lemons_hero_main.png" alt="Sell Lemons lever sequence checklist" width="894" height="500" />
      </div>
    </section>

    <article class="guide-detail">
      <section class="tool-panel" aria-labelledby="lever-checklist-title">
        <div>
          <p class="eyebrow">Start Lever Checklist</p>
          <h2 id="lever-checklist-title">Route Tabs</h2>
          <p class="evidence-note">Evidence boundary: these are reported player routes. Do not call them official or verified without a current live check.</p>
        </div>
        <div class="route-tabs" role="tablist" aria-label="Lever route checklists">
          {routeChecklists.map((route, index) => (
            <button
              class={`tier-pill ${index === 0 ? "is-active" : ""}`}
              type="button"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`${route.id}-checklist-panel`}
              data-lever-tab={route.id}
            >
              <span class="tier-pill__dot"></span>
              {route.label}
            </button>
          ))}
        </div>
        {routeChecklists.map((route, routeIndex) => (
          <section
            class={`guide-panel ${routeIndex === 0 ? "is-active" : ""}`}
            id={`${route.id}-checklist-panel`}
            data-lever-panel={route.id}
            aria-labelledby={`${route.id}-checklist-title`}
          >
            <span class="tag">{route.status}</span>
            <h3 id={`${route.id}-checklist-title`}>{route.title}</h3>
            <p>{route.note}</p>
            <ol class="checklist">
              {route.steps.map((step, index) => (
                <li>
                  <label>
                    <input type="checkbox" data-lever-check={`${route.id}-${index}`} data-route={route.id} />
                    <span><em>{route.status}</em>{step}</span>
                  </label>
                </li>
              ))}
            </ol>
            <button class="button secondary tool-button" type="button" data-reset-route={route.id}>Reset This Route</button>
          </section>
        ))}
      </section>

      <h2>What This Lever Sequence Tracks</h2>
      <p>This Sell Lemons Lever Sequence page tracks two reported underground routes: Sewer Key and UFO Key. Use it as a mobile checklist while keeping the route labels conservative. A checked box means personal progress in this browser, not proof that the route is official or current for every player.</p>

      <h2>Wrong State Recovery</h2>
      <div class="info-grid">
        {recoveryNotes.map((item) => (
          <section class="guide-step-card">
            <span class="tag">{item.status}</span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </section>
        ))}
      </div>

      <h2>Conflict Notes</h2>
      <p class="evidence-note">The shorter five-color route is kept as disputed because it does not fully match the longer Sewer Key and UFO Key routes found in current guide sources. Blue and Teal are also treated as naming variants until the site can verify the live maze directly.</p>
      <div class="route-table">
        {routeSummaryRows.map((row) => (
          <div>
            <strong>{row.route} <span class="tag">{row.status}</span></strong>
            <span>{row.summary}</span>
          </div>
        ))}
      </div>

      <VideoGuideBlock
        id="lever-video-guides"
        title="Lever Video References"
        note="youtube_embed: these videos help with visual lever locations and route context, but they do not verify route state, rewards, or badge outcomes."
        videos={youtubeEmbeds}
      />

      <h2>FAQ</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-card">
            <summary>{item.question}</summary>
            <div class="faq-card__body">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <div class="mini-table">
        <a href="/maze-map/">Open broad maze map</a>
        <a href="/sewer-maze-map/">Open maze map</a>
        <a href="/sewer-key/">Prepare sewer key</a>
        <a href="/ufo-key/">Continue to UFO key</a>
        <a href="/badge-tracker/">Track badge progress</a>
        <a href="/deals/">Open secrets hub</a>
      </div>

      <RelatedGuides currentSlug="lever-sequence" />
    </article>
  </main>

  <script is:inline>
    const storageKey = "sell-lemons-lever-sequence";
    const boxes = Array.from(document.querySelectorAll("[data-lever-check]"));
    const saved = new Set(JSON.parse(localStorage.getItem(storageKey) || "[]"));
    const saveState = () => {
      const checked = boxes.filter((item) => item.checked).map((item) => item.dataset.leverCheck);
      localStorage.setItem(storageKey, JSON.stringify(checked));
    };

    boxes.forEach((box) => {
      box.checked = saved.has(box.dataset.leverCheck);
      box.addEventListener("change", saveState);
    });

    document.querySelectorAll("[data-reset-route]").forEach((button) => {
      button.addEventListener("click", () => {
        const route = button.dataset.resetRoute;
        boxes.forEach((box) => {
          if (box.dataset.route === route) box.checked = false;
        });
        saveState();
      });
    });

    const leverTabs = Array.from(document.querySelectorAll("[data-lever-tab]"));
    const leverPanels = Array.from(document.querySelectorAll("[data-lever-panel]"));
    leverTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.leverTab;
        leverTabs.forEach((item) => {
          const isActive = item.dataset.leverTab === target;
          item.classList.toggle("is-active", isActive);
          item.setAttribute("aria-selected", String(isActive));
        });
        leverPanels.forEach((panel) => {
          panel.classList.toggle("is-active", panel.dataset.leverPanel === target);
        });
      });
    });
  </script>
</SiteLayout>
