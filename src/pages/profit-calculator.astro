---
// input: User-entered Roblox Sell Lemons income, upgrade, target cash, session length, gamepass assumptions, and YouTube money references
// output: Static Sell Lemons calculator page with ROI, gamepass ROI, break even, goal time, session estimates, videos, and FAQ
// pos: /Users/tangjei/Documents/建站/游戏站/selllemonswiki/src/pages/profit-calculator.astro (更新规则：文件变更需同步本注释与所属目录 README)
import SiteLayout from "../layouts/SiteLayout.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import VideoGuideBlock from "../components/VideoGuideBlock.astro";

const formulaNotes = [
  {
    title: "Break even time",
    formula: "upgrade cost / added income per minute",
    note: "Use this to compare whether the next purchase earns back its own cost quickly enough."
  },
  {
    title: "Time to goal",
    formula: "(target cash - current cash) / effective income per minute",
    note: "Use this when you need a cash target for a route, rebirth, key step, or upgrade chain."
  },
  {
    title: "Session cash",
    formula: "effective income per minute x planned minutes",
    note: "Offline income is optional and remains an editable estimate, not an official value."
  },
  {
    title: "Gamepass ROI",
    formula: "time saved or added income / Robux decision cost",
    note: "Use this as a judgment aid only because this page cannot price your personal Robux value."
  }
];

const interpretationCards = [
  {
    title: "High priority",
    status: "estimated",
    note: "The upgrade pays back within about 10 active minutes and supports your next route."
  },
  {
    title: "Medium priority",
    status: "estimated",
    note: "The upgrade can be useful, but compare it with a manager, route unlock, or rebirth target first."
  },
  {
    title: "Low priority",
    status: "estimated",
    note: "The upgrade pays back slowly. Save cash unless it unlocks a required milestone."
  }
];

const decisionCards = [
  {
    title: "Before a route push",
    status: "estimated",
    note: "Check whether the next upgrade pays back before you enter a Sewer Key, UFO Key, Evolution, or Ascension route."
  },
  {
    title: "Before going offline",
    status: "pending",
    note: "Use your own offline rate assumption. This site does not verify a fixed offline earning percentage."
  },
  {
    title: "Before a reset",
    status: "estimated",
    note: "Compare current-run payback against rebuild speed so a reset does not erase a better short-term route."
  },
  {
    title: "Before a gamepass",
    status: "estimated",
    note: "Test whether 2x Cash, Remote Buy, or instant-profit claims solve your actual bottleneck before spending Robux."
  }
];

const scenarioPresets = [
  { title: "Early-game route", status: "estimated", note: "Use low income and short session minutes to compare first automators against stand upgrades." },
  { title: "Before rebirth", status: "estimated", note: "Compare rebuild time against the investor bonus you expect after resetting." },
  { title: "Before evolution", status: "reported", note: "Check whether your current route can survive a larger reported speed-layer reset." },
  { title: "Gamepass ROI", status: "estimated", note: "Model 2x Cash as a multiplier or Remote Buy as time saved, then decide whether the purchase matters." }
];

const youtubeEmbeds = [
  {
    title: "The Best Money Guide in Sell Lemons Roblox",
    embedUrl: "https://www.youtube-nocookie.com/embed/89R0pSgQ7fI",
    sourceUrl: "https://www.youtube.com/watch?v=89R0pSgQ7fI",
    status: "youtube_embed",
    note: "Use as visual money-route context only. It does not verify ROI, payout, or upgrade priority."
  },
  {
    title: "These Tips WILL MAKE YOU RICH In Sell Lemons",
    embedUrl: "https://www.youtube-nocookie.com/embed/_q8yT5cmYS4",
    sourceUrl: "https://www.youtube.com/watch?v=_q8yT5cmYS4",
    status: "youtube_embed",
    note: "Shows search demand for fast-money advice, not proof of certain income."
  },
  {
    title: "Sell Lemons Guide",
    embedUrl: "https://www.youtube-nocookie.com/embed/NUMf7hgpslI",
    sourceUrl: "https://www.youtube.com/watch?v=NUMf7hgpslI",
    status: "youtube_embed",
    note: "General gameplay context only. Calculator output still depends on your entered numbers."
  }
];

const faqItems = [
  {
    question: "Is this profit calculator reading my live Roblox account?",
    answer: "No. The calculator is estimated because it only uses numbers you enter on this page."
  },
  {
    question: "What offline rate should I use?",
    answer: "Use 0 until you have your own current in-game evidence. Offline rates are pending because third-party claims conflict."
  },
  {
    question: "When is ROI not enough?",
    answer: "A slow upgrade can still matter if it unlocks a route, manager, reset layer, or required button. Treat the result as a decision aid, not an order."
  },
  {
    question: "Can this calculator decide whether a gamepass is worth Robux?",
    answer: "It can estimate time saved or added income, but it cannot decide your personal Robux value. Use it to pressure-test 2x Cash, Remote Buy, or instant-profit claims."
  },
  {
    question: "Is this for a real lemonade stand?",
    answer: "No. This is for the Roblox game Sell Lemons and does not calculate real business profit."
  },
  {
    question: "Is this an official Sell Lemons calculator?",
    answer: "No. It is an independent fan-site planner with visible formulas and estimated labels."
  }
];
---

<SiteLayout title="Roblox Sell Lemons Profit Calculator and ROI Planner" description="Use a Roblox Sell Lemons profit calculator for upgrade ROI, gamepass ROI, break even time, time to goal, session cash, and transparent planning formulas.">
  <main>
    <section class="page-hero guide-detail-hero">
      <div class="wrap page-hero__grid">
        <div>
          <p class="eyebrow">ROI Tool</p>
          <h1>Sell Lemons Profit Calculator</h1>
          <p>Compare Roblox Sell Lemons upgrade cost, goal timing, gamepass assumptions, and session value before spending cash or Robux. Every result is an estimated planning number based on player input and visible formulas, not official game math.</p>
        </div>
        <img src="/sell_lemons_hero_main.png" alt="Sell Lemons profit calculator upgrade ROI tool" width="894" height="500" />
      </div>
    </section>

    <article class="guide-detail">
      <section class="tool-panel" aria-labelledby="calculator-title">
        <div>
          <p class="eyebrow">Calculate Best Upgrade</p>
          <h2 id="calculator-title">Roblox Sell Lemons Upgrade ROI and Goal Estimate</h2>
          <p class="evidence-note">Evidence boundary: use reported or personal in-game numbers only. Results are marked estimated because the site is not reading live Roblox account data.</p>
        </div>
        <div class="calculator-grid">
          <label>
            Current income per minute
            <input id="currentIncome" type="number" min="0" step="1" value="10000" />
          </label>
          <label>
            Upgrade cost
            <input id="upgradeCost" type="number" min="0" step="1" value="50000" />
          </label>
          <label>
            Added income per minute
            <input id="incomeGain" type="number" min="0" step="1" value="2500" />
          </label>
          <label>
            Active multiplier
            <input id="multiplier" type="number" min="0" step="0.1" value="1" />
          </label>
          <label>
            Current cash
            <input id="currentCash" type="number" min="0" step="1" value="0" />
          </label>
          <label>
            Target cash
            <input id="targetCash" type="number" min="0" step="1" value="250000" />
          </label>
          <label>
            Session minutes
            <input id="sessionMinutes" type="number" min="0" step="1" value="30" />
          </label>
          <label>
            Offline minutes
            <input id="offlineMinutes" type="number" min="0" step="1" value="0" />
          </label>
          <label>
            Offline estimate rate
            <input id="offlineRate" type="number" min="0" max="100" step="1" value="0" />
          </label>
        </div>
        <div class="preset-row" aria-label="Session duration presets">
          <button class="button secondary" type="button" data-session-preset="15">15 minutes</button>
          <button class="button secondary" type="button" data-session-preset="30">30 minutes</button>
          <button class="button secondary" type="button" data-session-preset="60">60 minutes</button>
        </div>
        <button class="button primary tool-button" type="button" id="calculateRoi">Calculate Best Upgrade</button>
        <div class="result-panel" id="roiResult" aria-live="polite">
          Enter your upgrade numbers, then run the estimate.
        </div>
      </section>

      <h2>What This Calculator Estimates</h2>
      <p>This Sell Lemons Profit Calculator estimates break-even time, time-to-goal, session cash, and optional offline cash from numbers you provide. It does not connect to Roblox, does not read live account data, and does not confirm hidden game formulas. Use it to compare choices before spending cash, then verify important thresholds in-game.</p>

      <h2>Scenario Presets to Model</h2>
      <div class="info-grid">
        {scenarioPresets.map((item) => (
          <section class="guide-step-card">
            <span class="tag">{item.status}</span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </section>
        ))}
      </div>

      <h2>Why ROI Matters Before You Buy</h2>
      <div class="info-grid">
        {decisionCards.map((item) => (
          <section class="guide-step-card">
            <span class="tag">{item.status}</span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </section>
        ))}
      </div>

      <h2>Formula Notes</h2>
      <div class="info-grid">
        {formulaNotes.map((item) => (
          <section class="guide-step-card">
            <span class="tag">estimated</span>
            <h3>{item.title}</h3>
            <p><strong>{item.formula}</strong></p>
            <p>{item.note}</p>
          </section>
        ))}
      </div>

      <h2>How to Read the Result</h2>
      <div class="info-grid">
        {interpretationCards.map((item) => (
          <section class="guide-step-card">
            <span class="tag">{item.status}</span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </section>
        ))}
      </div>

      <VideoGuideBlock
        id="profit-calculator-video-guides"
        title="Video Money References"
        note="youtube_embed: these videos show money-route demand, but calculator results remain estimated and videos are not payout proof."
        videos={youtubeEmbeds}
      />

      <h2>FAQ</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-card">
            <summary>{item.question}</summary>
            <div class="faq-card__body">
              <p>{item.answer}</p>
            </div>
          </details>
        ))}
      </div>

      <h2>Useful Internal Routes</h2>
      <div class="mini-table">
        <a href="/income-sources/">Compare income sources</a>
        <a href="/best-upgrades/">Check upgrade priority</a>
        <a href="/money-fast/">Plan fastest money routes</a>
        <a href="/rebirths/">Review rebirth timing</a>
        <a href="/evolution/">Compare evolution timing</a>
        <a href="/ascension/">Plan ascension cost</a>
        <a href="/sewer-maze-map/">Check maze route costs</a>
      </div>

      <RelatedGuides currentSlug="profit-calculator" />
    </article>
  </main>

  <script is:inline>
    const readNumber = (id) => {
      const value = Number(document.getElementById(id)?.value || 0);
      return Number.isFinite(value) && value >= 0 ? value : 0;
    };

    const formatCash = (value) => Math.round(value).toLocaleString();
    const formatDuration = (minutes) => {
      if (!Number.isFinite(minutes)) return "not enough income data";
      if (minutes <= 0) return "ready now";
      if (minutes < 60) return `${minutes.toFixed(1)} minutes`;
      const hours = minutes / 60;
      return `${hours.toFixed(1)} hours`;
    };

    const result = document.getElementById("roiResult");
    const calculate = () => {
      const currentIncome = readNumber("currentIncome");
      const upgradeCost = readNumber("upgradeCost");
      const incomeGain = readNumber("incomeGain");
      const multiplier = Math.max(readNumber("multiplier"), 0);
      const currentCash = readNumber("currentCash");
      const targetCash = readNumber("targetCash");
      const sessionMinutes = readNumber("sessionMinutes");
      const offlineMinutes = readNumber("offlineMinutes");
      const offlineRate = Math.min(readNumber("offlineRate"), 100) / 100;
      const effectiveGain = incomeGain * multiplier;
      const effectiveIncome = currentIncome * multiplier;

      if (!result) return;
      if (upgradeCost <= 0 || effectiveGain <= 0 || effectiveIncome <= 0) {
        result.textContent = "Add positive income, upgrade cost, income gain, and multiplier values to calculate an estimated result.";
        return;
      }

      const paybackMinutes = upgradeCost / effectiveGain;
      const newIncome = currentIncome + effectiveGain;
      const roi = (effectiveGain / upgradeCost) * 100;
      const remainingCash = Math.max(targetCash - currentCash, 0);
      const goalMinutes = remainingCash / effectiveIncome;
      const sessionCash = effectiveIncome * sessionMinutes;
      const offlineCash = currentIncome * offlineRate * offlineMinutes;
      const upgradeSessionNet = effectiveGain * sessionMinutes - upgradeCost;
      const priority = paybackMinutes <= 10 ? "High priority" : paybackMinutes <= 30 ? "Medium priority" : "Low priority";

      result.innerHTML = `
        <strong>${priority} · estimated</strong>
        <span>Break even time: ${formatDuration(paybackMinutes)} estimated</span>
        <span>Time to target: ${formatDuration(goalMinutes)} estimated</span>
        <span>Session cash: ${formatCash(sessionCash)} estimated active cash</span>
        <span>Offline estimate: ${formatCash(offlineCash)} optional cash at your chosen rate</span>
        <span>Estimated new income: ${formatCash(newIncome)} per minute</span>
        <span>Upgrade session net: ${formatCash(upgradeSessionNet)}</span>
        <span>ROI per minute: ${roi.toFixed(2)}%</span>
      `;
    };

    document.querySelectorAll("[data-session-preset]").forEach((button) => {
      button.addEventListener("click", () => {
        const sessionInput = document.getElementById("sessionMinutes");
        if (!sessionInput) return;
        sessionInput.value = button.dataset.sessionPreset || "30";
        calculate();
      });
    });
    document.getElementById("calculateRoi")?.addEventListener("click", calculate);
  </script>
</SiteLayout>
