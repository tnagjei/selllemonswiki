      <div class="info-grid">
        {stageRoutes.map((route) => (
          <section class="guide-step-card">
            <span class="tag">{route.status}</span>
            <h3>{route.title}</h3>
            <ul>
              {route.steps.map((step) => <li>{step}</li>)}
            </ul>
          </section>
        ))}
      </div>

      <VideoGuideBlock
        id="money-video-guides"
        title="Video Money Route References"
        note="youtube_embed: these videos show fast-money route demand and visual play patterns, but they are not verified payout, multiplier, or guaranteed result proof."
        videos={youtubeEmbeds}
      />

      <h2>Active vs Offline vs Reset</h2>
      <div class="route-table">
        {comparisonRows.map((item) => (
          <div>
            <strong>{item.route} <span class="tag">{item.status}</span></strong>
            <span>{item.bestUse}</span>
          </div>
        ))}
      </div>

      <h2>Common Money Mistakes</h2>
      <ol class="mobile-step-list">
        {mistakes.map((item) => <li>{item}</li>)}
      </ol>

      <h2>Risky Claims We Do Not Verify</h2>
      <div class="info-grid">
        {riskyClaims.map((item) => (
          <section class="guide-step-card">
            <span class="tag">{item.status}</span>
            <h3>{item.title}</h3>
            <p>{item.note}</p>
          </section>
        ))}
      </div>

      <h2>Calculator Check</h2>
      <p>When two upgrades look close, use break even time and time-to-goal instead of guessing. A route that pays back in minutes is usually safer than a route that only sounds strong in a video title.</p>
      <div class="mini-table">
