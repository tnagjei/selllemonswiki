const sewerKeySteps = [
  { step: "1", action: "Blue or Teal", note: "Start with the blue/teal lever naming variant used across community guides." },
  { step: "2", action: "Red", note: "Move to the Red lever branch after the first room is set." },
  { step: "3", action: "Green", note: "Set Green, then return carefully to the known split." },
  { step: "4", action: "Red off", note: "Return to Red and turn it off for the reported Sewer Key state." },
  { step: "5", action: "Blue or Teal off", note: "Return to the first lever and turn it off." },
  { step: "6", action: "Purple", note: "Set Purple before the final Red step." },
  { step: "7", action: "Red", note: "Set Red again, then check the key pickup and gate path." }
];

const recoveryNotes = [
  {
    title: "Wrong lever state",
    status: "reported",
    note: "Use a fresh server or restart from the main split instead of adding random lever pulls."
  },
  {
    title: "Gate still closed",
    status: "reported",
    note: "Recheck whether Blue/Teal was turned off before Purple and final Red."
  },
  {
    title: "Reward amount claims",
    status: "disputed",
    note: "Cosmic Cash Vine payout values conflict, so this page only treats the route and timing as reported."
  }
];

const youtubeEmbeds = [
  {
    title: "How To GET SEWER KEY in SELL LEMONS",
    embedUrl: "https://www.youtube-nocookie.com/embed/KvYYqptZAIY",
