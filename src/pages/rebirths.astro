---
import SiteLayout from "../layouts/SiteLayout.astro";
import RelatedGuides from "../components/RelatedGuides.astro";
import { siteConfig } from "../data/config";
import { evidenceNotice, reportedRebirthInfo } from "../data/reported-guides";
---

<SiteLayout title={`Rebirths | ${siteConfig.siteName}`} description={`Pending rebirth mechanic research for ${siteConfig.gameName}.`}>
  <main class="content-page">
    <section class="prose-block">
      <p class="eyebrow">Rebirths</p>
      <h1>{siteConfig.gameName} Rebirths</h1>
      <p>{evidenceNotice.body}</p>
      <p>This page tracks reported rebirth mechanic research for {siteConfig.gameName}. Rebirth requirements, bonuses, and multipliers are not verified unless supported by official evidence.</p>
    </section>
    <section class="section">
      <h2>Reported rebirth research</h2>
      <div class="card-grid">
        {reportedRebirthInfo.map((item) => (
          <article class="card">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
            <p class="source-label">{item.sourceLabel}</p>
          </article>
        ))}
      </div>
    </section>
    <RelatedGuides currentSlug="rebirths" />
  </main>
</SiteLayout>
