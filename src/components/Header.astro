---
// input: siteConfig, getAvailableLocales, getMainNavItems
// output: Header navigation layout with logo, nav links, and locale selector
// pos: /Users/tangjei/Documents/建站/游戏站/selllemonswiki/src/components/Header.astro (更新规则：文件变更需同步本注释与所属目录 README)
import { siteConfig } from "../data/config";
import { getAvailableLocales, getMainNavItems } from "../lib/navigation";

const navItems = getMainNavItems();
const locales = getAvailableLocales();
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-mark">GG</span>
    <span>
      <strong>{siteConfig.siteName}</strong>
      <small>Roblox wiki hub</small>
    </span>
  </a>
  <nav aria-label="Main navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <details class="language-menu">
    <summary>Language</summary>
    <div class="language-list">
      {locales.map((item) => (
        <a href={item.completed ? item.href : "#"} aria-disabled={item.completed ? "false" : "true"}>
          {item.label}{item.completed ? "" : " · pending"}
        </a>
      ))}
    </div>
  </details>
</header>
