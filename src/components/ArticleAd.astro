---
// input: siteConfig.analytics.articleAdKey
// output: Inline article iframe ad banner (468x60 format)
// pos: /Users/tangjei/Documents/建站/游戏站/selllemonswiki/src/components/ArticleAd.astro (更新规则：文件变更需同步本注释与所属目录 README)
import { siteConfig } from "../data/config";

const adKey = siteConfig.analytics.articleAdKey;
---

{adKey && (
  <div class="article-ad-box" style="margin: 24px auto; text-align: center; display: flex; justify-content: center; align-items: center; min-height: 60px; overflow: hidden; max-width: 100%;">
    <script is:inline set:html={`
      atOptions = {
        'key' : '${adKey}',
        'format' : 'iframe',
        'height' : 60,
        'width' : 468,
        'params' : {}
      };
    `} />
    <script src={`https://www.highperformanceformat.com/${adKey}/invoke.js`} is:inline></script>
  </div>
)}
